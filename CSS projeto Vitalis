

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:'Poppins',sans-serif;
    background:#f8f9fb;
    color:#222;
}


header{
    width:100%;
    background:#fff;
    box-shadow:0 2px 15px rgba(0,0,0,.08);
    position:sticky;
    top:0;
    z-index:1000;
}

.navbar{
    max-width:1200px;
    margin:auto;
    padding:20px 40px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo h1{
    font-family:'Rowdies',cursive;
    color:#14B787;
    font-size:42px;
}

.menu{
    display:flex;
    list-style:none;
    gap:30px;
}

.menu a{
    text-decoration:none;
    color:#222;
    font-weight:500;
    transition:.3s;
}

.menu a:hover{
    color:#14B787;
}

.buttons{
    display:flex;
    gap:15px;
}

.btn-login{

    color:#14B787;
    border:2px solid #14B787;
    text-decoration:none;
    padding:10px 22px;
    border-radius:30px;
    transition:.3s;

}

.btn-login:hover{

    background:#14B787;
    color:white;

}

.btn-cadastro{

    background:#14B787;
    color:white;
    text-decoration:none;
    padding:10px 22px;
    border-radius:30px;
    transition:.3s;

}

.btn-cadastro:hover{

    background:#0da173;

}



.hero{

    min-height:90vh;

    background:linear-gradient(135deg,#0CBC8C,#14B787);

    display:flex;
    justify-content:center;
    align-items:center;

    text-align:center;
    color:white;
    padding:60px 20px;

}

.hero-text{

    max-width:900px;

}

.hero h1{

    font-family:'Rowdies',cursive;
    font-size:65px;
    line-height:1.2;
    margin-bottom:25px;

}

.hero span{

    color:#FFE600;

}

.hero p{

    font-size:22px;
    line-height:1.8;
    margin-bottom:35px;

}

.hero-buttons{

    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;

}

.btn-primary{

    background:white;
    color:#14B787;
    text-decoration:none;
    padding:16px 35px;
    border-radius:40px;
    font-weight:bold;
    transition:.3s;

}

.btn-primary:hover{

    transform:translateY(-3px);

}

.btn-secondary{

    border:2px solid white;
    color:white;
    text-decoration:none;
    padding:16px 35px;
    border-radius:40px;
    transition:.3s;

}

.btn-secondary:hover{

    background:white;
    color:#14B787;

}



.infos{

    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
    margin-top:70px;

}

.infos div{

    background:white;
    color:#222;
    border-radius:15px;
    padding:30px;

    box-shadow:0 15px 40px rgba(0,0,0,.08);

}

.infos h3{

    font-family:'Rowdies';
    margin-bottom:12px;
    color:#14B787;

}

.infos span{

    color:#666;

}



.beneficios{

    padding:90px 20px;

}

.beneficios h2{

    text-align:center;
    font-size:45px;
    margin-bottom:20px;

}

.beneficios>p{

    text-align:center;
    max-width:700px;
    margin:auto;
    color:#666;
    margin-bottom:60px;

}

.cards{

    max-width:1200px;

    margin:auto;

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));

    gap:30px;

}

.card{

    background:white;

    padding:35px;

    border-radius:20px;

    transition:.3s;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.card:hover{

    transform:translateY(-10px);

}

.card h3{

    color:#14B787;

    margin-bottom:15px;

    font-family:'Montserrat';

}

.card p{

    color:#666;

    line-height:1.7;

}



footer{

    background:#111;

    color:white;

    padding:70px 30px;

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:40px;

}

footer h2{

    font-family:'Rowdies';

    color:#14B787;

    margin-bottom:15px;

}

footer h3{

    margin-bottom:20px;

    font-family:'Rowdies';

}

footer p{

    color:#ccc;

    line-height:1.8;

}

footer ul{

    list-style:none;

}

footer li{

    margin-bottom:12px;

    color:#ccc;

    cursor:pointer;

    transition:.3s;

}

footer li:hover{

    color:#14B787;

}

.copyright{

    background:#000;

    color:#aaa;

    text-align:center;

    padding:20px;

    font-size:14px;

}



@media(max-width:900px){

.navbar{

    flex-direction:column;

    gap:20px;

}

.menu{

    flex-wrap:wrap;

    justify-content:center;

}

.hero h1{

    font-size:45px;

}

.hero p{

    font-size:18px;

}

.infos{

    grid-template-columns:1fr;

}

}

@media(max-width:600px){

.hero h1{

    font-size:35px;

}

.hero-buttons{

    flex-direction:column;

}

.btn-primary,
.btn-secondary{

    width:100%;

}

.menu{

    gap:15px;

}

}
